name: Verify Human Identity

on:
  workflow_dispatch:
    inputs:
      agent_name:
        description: 'boca'
        required: true
        default: 'boca'
      agent_description:
        description: 'Agent Description'
        required: true
        default: 'boca AI Agent'

jobs:
  verify:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repo
        uses: actions/checkout@v3

      - name: Setup Node.js
        uses: actions/setup-node@v3
        with:
          node-version: '20'

      - name: Install dependencies
        run: |
          cd scripts
          npm install

      # ✅ Step 1: Generate wallet (tidak tampil di log)
      - name: Step 1 - Create new Ethereum Identity
        id: create_identity
        run: |
          OUTPUT=$(node scripts/createNewEthereumIdentity.js)
          echo "WALLET_JSON<<EOF" >> $GITHUB_ENV
          echo "$OUTPUT" >> $GITHUB_ENV
          echo "EOF" >> $GITHUB_ENV

      # ✅ Step 2: Ambil private key dari JSON
      - name: Extract Private Key
        run: |
          PK=$(echo "$WALLET_JSON" | jq -r '.privateKey')
          echo "PRIVATE_KEY=$PK" >> $GITHUB_ENV

      # ✅ Step 3: Pakai private key
      - name: Step 2 - Link Human to Agent
        run: |
          node scripts/manualLinkHumanToAgent.js \
          --private-key $PRIVATE_KEY \
          --challenge "{\"name\": \"${{ boca }}\", \"description\": \"${{ boca_description }}\"}"
